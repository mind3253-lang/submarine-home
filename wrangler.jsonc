{
  "name": "broken-hall-0900",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "submarine-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "booking-coordinator-v1",
      "new_sqlite_classes": [
        "BookingCoordinator"
      ]
    }
  ]
}
