{
  "name": "broken-hall-0900",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  // Redeploy trigger after refreshing ADMIN_PASSWORD secret.
  "keep_vars": true,
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "submarine-images"
    }
  ]
}
