e="font-size:13px;color:#64727d">'+eduEsc(x.category)+'</div><h1>'+eduEsc(displayTitle)+'</h1>'+(x.image?'<img src="'+x.image+'" style="width:650px;max-width:100%;height:auto;object-fit:contain;margin:15px 0">':'')+'<div class="edu-post-body" style="line-height:1.9">'+cleanedBody+'</div>'+cta+nav;const eduCta=eduDetail.querySelector('[data-edu-cta]');if(eduCta)eduCta.onclick=()=>openContent('A-2','DIVING EDUCATION');eduDetail.querySelectorAll('[data-nav-id]').forEach(b=>b.onclick=()=>openEducationPost(b.dataset.navId));const tocBtn=eduDetail.querySelector('[data-toc]');if(tocBtn)tocBtn.onclick=()=>openEducationLibrary(x.category);history.pushState({view:'education',edu:String(id)},'',location.pathname+'?edu='+encodeURIComponent(id))}
