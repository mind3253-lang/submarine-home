function freedivingPostMeta(id){
 const m=String(id||'').match(/^freediving-(\d+)-(\d+)$/);if(!m)return null;
 const ci=Number(m[1])-1,ii=Number(m[2])-1,ch=FREEDIVING_TOC[ci];if(!ch||!ch[1][ii])return null;
 const flat=[];FREEDIVING_TOC.forEach((c,cx)=>c[1].forEach((t,ix)=>flat.push({id:'freediving-'+(cx+1)+'-'+(ix+1),label:(cx+1)+'-'+(ix+1)+') '+t})));
 const pos=flat.findIndex(v=>v.id===String(id));return {label:(ci+1)+'-'+(ii+1)+') '+ch[1][ii],prev:pos>0?flat[pos-1]:null,next:pos>=0&&pos<flat.length-1?flat[pos+1]:null};
}
function curriculumPostMeta(category,id){let toc=null,prefix='';if(category==='프리다이빙'){toc=FREEDIVING_TOC;prefix='freediving'}else if(category==='주니어 프다'){toc=JUNIOR_TOC;prefix='junior'}else if(category==='스쿠버다이빙'){toc=SCUBA_TOC;prefix='scuba'}else if(category==='머메이드'){toc=MERMAID_TOC;prefix='mermaid'}else return null;const flat=[];toc.forEach((ch,ci)=>ch[1].forEach((title,i)=>flat.push({id:prefix+'-'+(ci+1)+'-'+(i+1),label:title})));const n=flat.findIndex(v=>v.id===String(id));if(n<0)return null;const parts=String(id).split('-'),number=(parts[parts.length-2]||'')+'-'+(parts[parts.length-1]||'')+') ';return {label:number+flat[n].label,prev:n?flat[n-1]:null,next:n<flat.length-1?flat[n+1]:null,category};}
