 if(code==='B-2'){articleBody.innerHTML=renderB2Facilities();return;}
 const item=data[code];
 if(!item){articleBody.innerHTML='<p>아직 작성된 내용이 없습니다. 관리자 페이지에서 '+code+' 콘텐츠를 작성하세요.</p>';return;}
 let html='';
 if(item.images && item.images.length){
   html += '<div class="article-media">';
   item.images.forEach(src=>html+='<img src="'+src+'">');
   html += '</div>';
 }
 html += '<div class="article-text">'+(item.body||'')+'</div>';
 articleBody.innerHTML=html;
}
