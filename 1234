async function openEducationLibrary(category){show('education');bindPageBrand(educationBrand,'E');eduDetail.style.display='none';eduList.style.display='block';if(category==='프리다이빙'&&!new URLSearchParams(location.search).has('edu')&&history.state?.view!=='education-toc')history.pushState({view:'education-toc'},'',location.pathname+'?library=freediving');try{const r=await fetch('/api/education-posts',{cache:'no-store'}),j=await r.json();EDUCATION_POSTS=j.posts||[]}catch(e){EDUCATION_POSTS=[]}eduCategoryBar.innerHTML=EDU_CATS.map(c=>'<button type="button" class="edu-category-card '+(category===c[0]?'active':'')+'" data-edu-cat="'+c[0]+'"><img src="'+c[1]+'" alt="'+c[0]+'"><span>'+c[0]+'</span></button>').join('');eduCategoryBar.querySelectorAll('[data-edu-cat]').forEach(b=>b.onclick=()=>openEducationLibrary(b.dataset.eduCat));if(!category){eduList.innerHTML='<p style="color:#66727a;text-align:center;padding:10px 0">카테고리를 선택하세요.</p>';return}if(category==='프리다이빙'){eduList.innerHTML=renderFreedivingToc();eduList.querySelectorAll('[data-fd-id]').forEach(b=>b.onclick=()=>openEducationPost(b.dataset.fdId));return}if(category==='주니어 프다'){eduList.innerHTML=renderJuniorToc();eduList.querySelectorAll('[data-jr-id]').forEach(b=>b.onclick=()=>openEducationPost(b.dataset.jrId));return}if(category==='스쿠버다이빙'){eduList.innerHTML=renderScubaToc();eduList.querySelectorAll('[data-sc-id]').forEach(b=>b.onclick=()=>openEducationPost(b.dataset.scId));return}if(category==='머메이드'){eduList.innerHTML=renderMermaidToc();eduList.querySelectorAll('[data-mm-id]').forEach(b=>b.onclick=()=>openEducationPost(b.dataset.mmId));return}const rows=EDUCATION_POSTS.filter(x=>x.category===category).sort((x,y)=>String(y.createdAt||'').localeCompare(String(x.createdAt||'')));eduList.innerHTML=rows.length?rows.map(x=>'<article style="padding:18px 0;border-bottom:1px solid #e5eaee;cursor:pointer" data-edu-id="'+x.id+'"><div style="font-size:13px;color:#64727d">'+eduEsc(x.category)+'</div><h3 style="margin:6px 0">